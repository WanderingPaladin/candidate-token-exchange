{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "TokenExchange": {
    "IncomingIssuer": "https://idp.caseware.example",
    "IncomingAudience": "collaborate",
    "OutgoingIssuer": "https://collaborate.caseware.example",
    "DelegatedTokenLifetimeMinutes": 2,
    "DevelopmentSigningKey": "DEVONLY_NOT_A_PRODUCTION_SECRET_256BIT_MINIMUM!"
  },
  "DownstreamApis": {
    "document-service": [ "documents.read", "documents.write" ],
    "comments-service": [ "comments.read", "comments.write" ],
    "financial-data-api": [ "financial.read" ]
  },
  "Clients": {
    "notification-service": {
      "document-service": [ "documents.read" ],
      "comments-service": [ "comments.read" ]
    },
    "privileged-internal-service": {
      "document-service": [ "documents.read", "documents.write" ]
    }
  }
}
